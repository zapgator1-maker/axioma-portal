\par
  <style>\par
    /* \f2\u9472?\u9472?\u9472?\f0  RESET & BASE \f2\u9472?\u9472?\u9472?\f0  */\par
    *, *::before, *::after \{ box-sizing: border-box; margin: 0; padding: 0; \}\par
\par
    :root \{\par
      --navy:  #08101E;\par
      --amber: #FF6600;\par
      --cyan:  #00E5FF;\par
      --white: #E8EDF2;\par
      --muted: #4A5A6E;\par
      --glass: rgba(8,16,30,0.72);\par
    \}\par
\par
    html \{ scroll-behavior: smooth; \}\par
\par
    body \{\par
      background: var(--navy);\par
      color: var(--white);\par
      font-family: 'Inter', sans-serif;\par
      font-weight: 300;\par
      overflow-x: hidden;\par
    \}\par
\par
    /* \f2\u9472?\u9472?\u9472?\f0  SCANNER LINE (assinatura \'fanica) \f2\u9472?\u9472?\u9472?\f0  */\par
    .scanner \{\par
      position: fixed;\par
      top: 0; left: 0;\par
      width: 100%; height: 2px;\par
      background: linear-gradient(90deg, transparent 0%, var(--cyan) 40%, var(--amber) 60%, transparent 100%);\par
      opacity: 0.35;\par
      z-index: 9999;\par
      animation: scan 6s linear infinite;\par
      pointer-events: none;\par
    \}\par
    @keyframes scan \{\par
      0%   \{ transform: translateY(0); opacity: 0.35; \}\par
      48%  \{ opacity: 0.35; \}\par
      50%  \{ opacity: 0; transform: translateY(100vh); \}\par
      50.1%\{ transform: translateY(0); opacity: 0; \}\par
      52%  \{ opacity: 0.35; \}\par
      100% \{ transform: translateY(100vh); opacity: 0.35; \}\par
    \}\par
\par
    /* \f2\u9472?\u9472?\u9472?\f0  NAV \f2\u9472?\u9472?\u9472?\f0  */\par
    nav \{\par
      position: fixed;\par
      top: 0; left: 0; right: 0;\par
      z-index: 1000;\par
      display: flex;\par
      align-items: center;\par
      justify-content: space-between;\par
      padding: 1.25rem 3rem;\par
      background: rgba(8,16,30,0.85);\par
      backdrop-filter: blur(12px);\par
      border-bottom: 1px solid rgba(0,229,255,0.08);\par
    \}\par
    .nav-logo \{\par
      font-family: 'Orbitron', sans-serif;\par
      font-weight: 900;\par
      font-size: 1rem;\par
      letter-spacing: 0.18em;\par
      color: var(--cyan);\par
    \}\par
    .nav-logo span \{ color: var(--amber); \}\par
    nav ul \{\par
      list-style: none;\par
      display: flex;\par
      gap: 2.5rem;\par
    \}\par
    nav ul li a \{\par
      font-family: 'Rajdhani', sans-serif;\par
      font-size: 0.8rem;\par
      letter-spacing: 0.2em;\par
      text-transform: uppercase;\par
      color: var(--muted);\par
      text-decoration: none;\par
      transition: color 0.25s;\par
    \}\par
    nav ul li a:hover \{ color: var(--cyan); \}\par
\par
    /* \f2\u9472?\u9472?\u9472?\f0  HERO \f2\u9472?\u9472?\u9472?\f0  */\par
    #hero \{\par
      position: relative;\par
      height: 100vh;\par
      display: flex;\par
      align-items: center;\par
      justify-content: center;\par
      overflow: hidden;\par
    \}\par
    #hero-video \{\par
      position: absolute;\par
      inset: 0;\par
      width: 100%; height: 100%;\par
      object-fit: cover;\par
      opacity: 0.55;\par
      /* SUBSTITUA o src abaixo pelo caminho do seu v\'eddeo */\par
    \}\par
    .hero-overlay \{\par
      position: absolute;\par
      inset: 0;\par
      background: radial-gradient(ellipse at center, transparent 30%, var(--navy) 85%);\par
    \}\par
    .hero-content \{\par
      position: relative;\par
      text-align: center;\par
      max-width: 860px;\par
      padding: 0 2rem;\par
    \}\par
    .hero-eyebrow \{\par
      font-family: 'Rajdhani', sans-serif;\par
      font-size: 0.75rem;\par
      letter-spacing: 0.35em;\par
      text-transform: uppercase;\par
      color: var(--cyan);\par
      margin-bottom: 1.5rem;\par
