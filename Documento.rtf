    @keyframes pulse \{ 0%,100%\{opacity:0.3\} 50%\{opacity:1\} \}\par
    @keyframes fadeUp \{ to \{ opacity: 1; transform: translateX(-50%) translateY(-6px); \} \}\par
\par
