      font-size: 0.85rem;\par
      letter-spacing: 0.25em;\par
      text-transform: uppercase;\par
      color: var(--navy);\par
      background: var(--amber);\par
      padding: 0.9rem 2.4rem;\par
      border: none;\par
      cursor: pointer;\par
      text-decoration: none;\par
      clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));\par
