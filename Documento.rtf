      font-size: 1.05rem;\par
      letter-spacing: 0.08em;\par
      color: var(--muted);\par
      max-width: 520px;\par
      margin-left: auto;\par
      margin-right: auto;\par
      opacity: 0;\par
    \}\par
    .hero-cta \{\par
      margin-top: 2.8rem;\par
